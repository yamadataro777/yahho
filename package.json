{
  "name": "affiliate-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler dev --local --ip 0.0.0.0",
    "db:local": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler d1 migrations apply affiliate-lab --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "research": "node scripts/research.mjs",
    "social-card": "node scripts/social-card.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
